# Valores por defecto del entorno Base44 (se versiona; no contiene secretos).
#
# Comunicación HTTP con el repositorio de muebles-cortecloud: nombres del `Host`
# y del `Origin` que el servidor MCP acepta en /mcp. Van sin esquema ni puerto y
# separados por comas; `localhost`, `127.0.0.1` y `[::1]` se aceptan siempre.
# Ver `docs/mcp-server.md` («Integración desde otra app»).

# Host con el que muebles-cortecloud llama a este servidor (MCP por HTTP).
MCP_ANFITRIONES=

# Origen de la página de muebles-cortecloud cuando llama desde el navegador.
MCP_ORIGENES=
